# 应用
APP_NAME=ecom-monitor
APP_ENV=dev                 # dev / prod
DEBUG=true
SECRET_KEY=change-me-in-prod
ACCESS_TOKEN_EXPIRE_MIN=720

# 数据库
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ecom
MYSQL_PASSWORD=ecom123
MYSQL_DB=ecom_monitor

# Redis（scrapy-redis 队列 / 缓存 / 锁）
REDIS_URL=redis://127.0.0.1:6379/0

# 管理调度
SCHEDULER_TICK_SEC=10
SCHEDULER_LEADER_TTL=30
DEAD_THRESHOLD=3

# 内部接口
NODE_API_KEY=dev-node-api-key

# 通知
CRYPTO_KEY_ID=v1
